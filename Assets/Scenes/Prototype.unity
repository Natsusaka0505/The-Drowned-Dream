  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a1bf2060ad8f415285419e1ec15cbac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DrownedDream.GameFlow
  _titleScreen: {fileID: 1240597170}
  _storyPanel: {fileID: 1240597169}
  _skipIntro: 0
  _introLines:
  - "\u53C8\u662F\u90A3\u500B\u5922\u2026\u2026"
  - "\u6F06\u9ED1\u7684\u6D77\u5E95\u6D1E\u7A9F\u6DF1\u8655\uFF0C\u6C89\u7761\u8457\u53E4\u8001\u90AA\u795E\u7684\u5BF6\u85CF\u3002"
  - "\u7942\u5728\u547C\u559A\u6211\u3002"
  - "\uFF08A/D \u79FB\u52D5\u3000W \u8DF3\u8E8D\u3000Space \u767C\u5C04\u9B5A\u53C9\u3000Q
    \u618B\u6C23\uFF09"
  _endingPages:
  - _image: {fileID: 21300000, guid: 82280dbdc06424bc9b18e6b0cbdc0e2d, type: 3}
    _lines:
    - "\u5C01\u5370\u5B8C\u6210\u7684\u77AC\u9593\uFF0C\u6D77\u6C34\u704C\u9032\u4E86\u6211\u7684\u80BA\u2014\u2014"
    - "\u56DB\u5468\u53EA\u5269\u4E0B\u9ED1\u6697\u2026\u2026\u548C\u9060\u65B9\u67D0\u500B\u547C\u559A\u6211\u7684\u8072\u97F3\u3002"
  - _image: {fileID: 21300000, guid: 00fc95a5434d345a9b1c897aeb2ff39e, type: 3}
    _lines:
    - "\u51B0\u51B7\u7684\u6D77\u6C34\uFF0C\u6162\u6162\u8B8A\u6210\u4E86\u67D4\u8EDF\u7684\u6795\u982D\u3002"
    - "\u90A3\u500B\u8072\u97F3\u9084\u5728\u8033\u908A\uFF0C\u8F15\u8F15\u5730\u2026\u2026"
  - _image: {fileID: 21300000, guid: 0f9bf93e5eb3240b1b5b5f655187ee43, type: 3}
    _lines:
    - "\u2014\u2014\uFF01"
    - "\u6211\u731B\u7136\u775C\u958B\u4E86\u773C\u775B\u3002"
  - _image: {fileID: 21300000, guid: 4d9a0c9b816be4cbfaa5d1700af24620, type: 3}
    _lines:
    - "\u719F\u6089\u7684\u623F\u9593\uFF0C\u719F\u6089\u7684\u5E8A\u3002"
    - "\u2026\u2026\u539F\u4F86\uFF0C\u5168\u90FD\u662F\u5922\u3002"
    - "\u6D1E\u7A9F\u3001\u90AA\u795E\u3001\u90A3\u4E9B\u96D5\u50CF\u2026\u2026\u5927\u6982\u53EA\u662F\u592A\u7D2F\u4E86\u5427\u3002"
  - _image: {fileID: 21300000, guid: 61257170fae234789b18873ebfd9179e, type: 3}
    _lines:
    - "\u76F4\u5230\u6211\u770B\u898B\u2014\u2014\u5E8A\u5E95\u4E0B\uFF0C\u6709\u4EC0\u9EBC\u6B63\u671B\u8457\u6211\u3002"
    - "\u300C\u8B1D\u8B1D\u4F60\u2026\u2026\u5E36\u6211\u56DE\u5BB6\u3002\u300D"
  - _image: {fileID: 0}
    _lines:
    - "The Drowned Dream\n\n\u2014 \u611F\u8B1D\u904A\u73A9 \u2014"
